# FastAPI settings
APP_NAME=Thesis Management API
ENV=dev
DEBUG=true

# Database (MySQL)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/thesis_mgmt?charset=utf8mb4

# JWT
JWT_SECRET_KEY=PLEASE_CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma separated)
CORS_ALLOW_ORIGINS=*

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.zip,.rar
