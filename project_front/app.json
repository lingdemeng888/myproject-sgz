{
  "pages": [
    "pages/splash/index"
  ],
  "subpackages": [
    {
      "root": "pages/auth",
      "name": "authPkg",
      "pages": [
        "identity/index"
      ]
    },
    {
      "root": "pages/student",
      "name": "studentPkg",
      "pages": [
        "login/index",
        "register/index",
        "home/index",
        "topic-list/index",
        "topic-detail/index",
        "my-applications/index",
        "my-papers/index",
        "paper-detail/index",
        "paper-version-edit/index",
        "profile/index"
      ]
    },
    {
      "root": "pages/tutor",
      "name": "tutorPkg",
      "pages": [
        "login/index",
        "register/index",
        "home/index",
        "topics/index",
        "topic-edit/index",
        "applications/index",
        "papers/index",
        "paper-detail/index",
        "profile/index"
      ]
    },
    {
      "root": "pages/admin",
      "name": "adminPkg",
      "pages": [
        "login/index",
        "home/index",
        "users/index",
        "departments/index",
        "majors/index",
        "logs/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/splash/index": {
      "packages": ["authPkg"],
      "network": "all"
    },
    "pages/auth/identity/index": {
      "packages": ["studentPkg", "tutorPkg", "adminPkg"],
      "network": "all"
    }
  },
  "window": {
    "navigationStyle": "custom",
    "backgroundTextStyle": "light",
    "backgroundColor": "#000000",
    "enablePullDownRefresh": false
  },
  "usingComponents": {
    "back-button": "/components/back-button/index"
  },
  "sitemapLocation": "sitemap.json"
}
