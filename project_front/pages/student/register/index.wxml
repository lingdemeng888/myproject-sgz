<view class="container">
  <image class="bg" src="../assets/乐技楼.jpg" mode="aspectFill"></image>
  <view class="overlay"></view>

  <view class="header">
    <text class="title-line">苏州高等职业技术学校</text>
    <text class="title-line">毕业设计选题管理系统</text>
  </view>

  <scroll-view class="content" scroll-y>
    <view class="card">
      <text class="section-title">学生注册</text>
      <input class="input" placeholder="学号" bindinput="onNo"/>
      <input class="input" placeholder="姓名" bindinput="onName"/>
      <input class="input" placeholder="班级全称" bindinput="onClazz"/>
      <view class="row">
        <input class="input flex1" placeholder="绑定手机号" bindinput="onPhone"/>
        <button class="btn btn-primary" size="mini" bindtap="sendCode">发送验证码</button>
      </view>
      <input class="input" placeholder="验证码（6位）" maxlength="6" bindinput="onCode"/>
      <input class="input" password placeholder="设置密码" bindinput="onPwd1"/>
      <input class="input" password placeholder="再次输入密码" bindinput="onPwd2"/>

      <view class="card small-verify">
        <text class="section-title">个人安全验证</text>
        <text class="text-white">请计算：{{a}} + {{b}} = ？</text>
        <input class="input" placeholder="请输入结果" bindinput="onVA"/>
      </view>

      <button class="btn btn-primary" bindtap="submit">提交注册</button>
      <view class="register-box" bindtap="backToLogin">已有账号？去登录</view>
    </view>
  </scroll-view>
</view>
