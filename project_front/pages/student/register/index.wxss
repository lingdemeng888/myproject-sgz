@import '../../../styles/common.wxss';

page {
	height: 100vh;
	background: #010101;
}

.page {
	position: relative;
	width: 100vw;
	height: 100vh;
	overflow: hidden;
}

.bg {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
}

.overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(135deg, rgba(8, 4, 0, 0.25), rgba(6, 3, 0, 0.72));
}

.hero {
	position: absolute;
	top: 6vh;
	left: 0;
	right: 0;
	text-align: center;
	z-index: 2;
	padding: 0 40rpx;
}

.hero-line {
	display: block;
	color: #fff;
	font-size: 60rpx;
	font-family: 'STXinwei','华文新魏','KaiTi','STKaiti','Noto Serif SC',serif;
	text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.6), 0 -2rpx 0 rgba(255,255,255,0.25);
	line-height: 1.8;
}

.role-chip {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	margin-top: 12rpx;
	padding: 6rpx 36rpx;
	border-radius: 999rpx;
	background: rgba(181,136,99,0.9);
	color: #fff;
	font-size: 28rpx;
	font-family: 'KaiTi','STKaiti','Kaiti SC','Noto Serif SC',serif;
	box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.35);
}

.hero-tip {
	display: block;
	margin-top: 12rpx;
	color: rgba(255,255,255,0.85);
	font-size: 26rpx;
	text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.45);
}

.form-scroll {
	position: absolute;
	top: 26vh;
	bottom: 0;
	left: 0;
	right: 0;
	padding: 0 40rpx 40rpx;
	z-index: 3;
	box-sizing: border-box;
}

.form-card {
	background: rgba(7, 9, 12, 0.72);
	border-radius: 32rpx;
	padding: 48rpx 44rpx 60rpx;
	box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.45);
	backdrop-filter: blur(10rpx);
}

.card-head {
	margin-bottom: 32rpx;
}

.card-title {
	display: block;
	color: #fff;
	font-size: 44rpx;
	font-family: 'KaiTi','STKaiti','Kaiti SC','Noto Serif SC',serif;
	text-shadow: 0 3rpx 6rpx rgba(0,0,0,0.5);
}

.card-desc {
	display: block;
	margin-top: 8rpx;
	color: rgba(255,255,255,0.82);
	font-size: 26rpx;
}

.input-group {
	display: flex;
	align-items: center;
	background: rgba(255,255,255,0.94);
	border-radius: 16rpx;
	padding: 0 28rpx;
	height: 100rpx;
	margin-bottom: 26rpx;
	box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.2);
}

.input-icon {
	font-size: 36rpx;
	margin-right: 16rpx;
}

.input-field {
	flex: 1;
	font-size: 30rpx;
	color: #1f1f1f;
}

.picker-group {
	padding-right: 0;
}

.picker-field {
	flex: 1;
	display: flex;
	align-items: center;
	height: 100%;
	padding: 0 28rpx 0 0;
}

.picker-text {
	font-size: 30rpx;
	color: #1f1f1f;
}

.helper-hint {
	color: rgba(255,255,255,0.75);
	font-size: 24rpx;
	margin: -8rpx 0 24rpx 8rpx;
}

.primary-btn {
	width: 100%;
	height: 100rpx;
	border: none;
	border-radius: 18rpx;
	background: linear-gradient(135deg, #b58863, #dfb37e);
	color: #fff;
	font-size: 32rpx;
	font-weight: 600;
	box-shadow: 0 12rpx 28rpx rgba(0,0,0,0.35);
	margin-top: 24rpx;
}

.primary-btn[disabled] {
	opacity: 0.65;
}

.link-row {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 16rpx;
	margin-top: 32rpx;
	font-size: 26rpx;
}

.hint-text {
	color: rgba(255,255,255,0.78);
}

.link-text {
	color: #ffe7c2;
}

.corner-dots {
	position: absolute;
	bottom: 36rpx;
	left: 50%;
	transform: translateX(-50%);
	display: flex;
	gap: 16rpx;
	z-index: 2;
}

.corner-dots .dot {
	width: 12rpx;
	height: 12rpx;
	border-radius: 50%;
	background: rgba(255,255,255,0.38);
}
