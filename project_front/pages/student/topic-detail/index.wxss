@import '../../../styles/common.wxss';

.page{min-height:100vh;background:#f7f7f5;padding:28rpx}
.card{background:#fff;border-radius:24rpx;padding:26rpx;margin-bottom:24rpx;box-shadow:0 10rpx 24rpx rgba(0,0,0,0.06)}
.title{font-size:34rpx;font-weight:600;color:#333;margin-bottom:12rpx}
.meta{font-size:26rpx;color:#666;margin-bottom:6rpx}
.desc{font-size:28rpx;color:#444;line-height:1.6;margin-top:12rpx;white-space:pre-line}
.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx;font-size:28rpx;color:#333}
.status-text{font-weight:600}
.status-desc{font-size:26rpx;color:#666;white-space:pre-line}
.textarea{background:#f5f5f5;border-radius:18rpx;padding:20rpx;font-size:28rpx;min-height:200rpx;margin-bottom:18rpx}
.btn{background:#b58863;color:#fff;border-radius:18rpx}
.hint{font-size:24rpx;color:#999}
.empty{padding:48rpx;text-align:center;color:#999}
