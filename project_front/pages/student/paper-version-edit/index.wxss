@import '../../../styles/common.wxss';

.page{min-height:100vh;background:#f7f7f5;padding:28rpx;box-sizing:border-box}
.card{background:#fff;border-radius:22rpx;padding:24rpx;margin-bottom:24rpx;box-shadow:0 8rpx 22rpx rgba(0,0,0,0.06)}
.label{font-size:28rpx;font-weight:600;color:#333;margin-bottom:12rpx}
.tip{font-size:24rpx;color:#999;margin-bottom:8rpx;line-height:1.5}
.textarea{min-height:220rpx;background:#f5f5f5;border-radius:16rpx;padding:18rpx;font-size:26rpx}
.picker{background:#f5f5f5;border-radius:16rpx;padding:18rpx;font-size:26rpx;color:#555}
.upload-btn{background:#b58863;color:#fff;border-radius:12rpx;margin-top:8rpx}
.file-list{margin-top:16rpx}
.file-item{display:flex;align-items:center;padding:12rpx;background:#f5f5f5;border-radius:12rpx;margin-bottom:8rpx}
.file-name{flex:1;font-size:24rpx;color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.file-size{font-size:22rpx;color:#999;margin:0 12rpx}
.remove-btn{font-size:22rpx;color:#f56c6c;padding:4rpx 12rpx}
.btn{width:100%;background:#b58863;color:#fff;border-radius:18rpx}
