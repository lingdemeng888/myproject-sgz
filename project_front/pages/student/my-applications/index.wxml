<back-button></back-button>
<view class="page">
  <view class="tabs">
    <view class="tab {{activeStatus === '' ? 'active' : ''}}" data-value="" bindtap="changeStatus">全部</view>
    <view class="tab {{activeStatus === 0 ? 'active' : ''}}" data-value="0" bindtap="changeStatus">待审批</view>
    <view class="tab {{activeStatus === 1 ? 'active' : ''}}" data-value="1" bindtap="changeStatus">已通过</view>
    <view class="tab {{activeStatus === 2 ? 'active' : ''}}" data-value="2" bindtap="changeStatus">已拒绝</view>
    <view class="tab {{activeStatus === 3 ? 'active' : ''}}" data-value="3" bindtap="changeStatus">已取消</view>
  </view>

  <block wx:if="{{applications.length}}">
    <view class="card" wx:for="{{applications}}" wx:key="id">
      <view bindtap="showDetail" data-index="{{index}}">
        <view class="card-header">
          <text class="title">{{item.topic_title}}</text>
          <text class="status" style="color: {{item.status_color}}">{{item.status_name}}</text>
        </view>
        <view class="meta">提交时间：{{item.created_at_fmt}}</view>
        <view class="meta" wx:if="{{item.decision_by_name}}">审批人：{{item.decision_by_name}}</view>
        <view class="reason">{{item.application_reason || '未填写申请理由'}}</view>
        <view class="comment" wx:if="{{item.decision_comment}}">导师意见：{{item.decision_comment}}</view>
      </view>
      <view class="actions" wx:if="{{item.status === 1}}">
        <button class="action-btn" wx:if="{{item.paper_id}}" size="mini" type="primary" bindtap="viewPaper" data-id="{{item.paper_id}}">查看论文</button>
        <button class="action-btn" wx:else size="mini" type="primary" bindtap="createPaper" data-application="{{item}}">创建论文</button>
      </view>
    </view>
  </block>
  <view class="empty" wx:else>暂无申请记录</view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="loading" wx:elif="{{!hasMore && applications.length}}">没有更多了</view>
</view>
