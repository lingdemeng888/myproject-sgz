@import '../../../styles/common.wxss';

.page{min-height:100vh;background:#f7f7f5;padding:28rpx;box-sizing:border-box}
.card{background:#fff;border-radius:22rpx;padding:24rpx;margin-bottom:24rpx;box-shadow:0 10rpx 24rpx rgba(0,0,0,0.06)}
.title{font-size:32rpx;font-weight:600;color:#333;margin-bottom:10rpx}
.meta{font-size:24rpx;color:#666;margin-bottom:6rpx}
.status{font-weight:600}
.desc{font-size:26rpx;color:#444;margin-top:10rpx;line-height:1.6;white-space:pre-line}
.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18rpx;font-size:28rpx;color:#333}
.mini-btn{background:#b58863;color:#fff;border-radius:12rpx}
.version{padding:16rpx 0;border-top:1px solid #f1f1f1}
.version:first-child{border-top:none;padding-top:0}
.version-header{display:flex;justify-content:space-between;color:#444;font-size:26rpx;margin-bottom:6rpx}
.time{font-size:24rpx;color:#999}
.version-notes{font-size:24rpx;color:#666;white-space:pre-line}
.review-section{margin-top:16rpx;padding:16rpx;background:#fff7ed;border-left:4rpx solid #b58863;border-radius:8rpx}
.review-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx}
.review-label{font-size:26rpx;color:#b58863;font-weight:600}
.review-time{font-size:22rpx;color:#999}
.review-content{font-size:26rpx;color:#333;line-height:1.6;white-space:pre-line;margin-bottom:8rpx}
.reviewer{font-size:22rpx;color:#999;text-align:right}
.btn{width:100%;background:#b58863;color:#fff;border-radius:18rpx}
.empty{text-align:center;color:#999;padding:40rpx}
