/* 背景与布局 */
.container {
  position: relative;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background: #000;
}
.bg {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  filter: brightness(0.85);
}
.overlay {
  position: absolute; inset: 0;
  background: rgba(0,0,0,0.25);
}

/* 中部主文案 */
.center {
  position: absolute; left: 0; right: 0; top: 50%;
  transform: translateY(-50%);
  text-align: center;
}
.title-line {
  display: block;
  color: #fff;
  /* 二号≈22pt≈29px；在小程序中折算约 58~60rpx，这里取 60rpx */
  font-size: 60rpx;
  font-family: 'STXinwei', '华文新魏', 'KaiTi', 'STKaiti', 'Noto Serif SC', serif;
  line-height: 1.7;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.65), 0 -2rpx 0 rgba(255,255,255,0.25);
}

/* 淡入淡出动画（脉冲式） */
.animated { animation: fadePulse 2400ms ease-in-out infinite; }
@keyframes fadePulse {
  0% { opacity: 0.3; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0.3; }
}

/* 底部说明 */
.bottom {
  position: absolute; left: 0; right: 0; bottom: 70rpx;
  text-align: center; color: #fff;
  padding: 0 40rpx;
  text-shadow: 0 3rpx 6rpx rgba(0,0,0,0.6);
}
.desc { display: block; margin-bottom: 12rpx; font-size: 26rpx; }
.count { display: block; font-size: 26rpx; }

/* 跳过按钮 */
.skip-btn {
  position: absolute;
  top: 60rpx;
  right: 40rpx;
  padding: 16rpx 32rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  z-index: 100;
}
.skip-btn text {
  color: #fff;
  font-size: 26rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}
