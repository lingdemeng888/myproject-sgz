@import '/styles/common.wxss';

.logs-page {
  min-height: 100vh;
  background: #f7f7f5;
  padding-bottom: 48rpx;
}

.filter-bar {
  background: #fff;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  flex: 1;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

.date-filter {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker {
  flex: 1;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.date-separator {
  font-size: 26rpx;
  color: #999;
}

.stats-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.stats-text {
  font-size: 26rpx;
  color: #666;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.clear-btn,
.refresh-btn {
  background: #e04b4b;
  color: #fff;
  border-radius: 999px;
  font-size: 24rpx;
}

.log-list {
  height: calc(100vh - 320rpx);
  padding: 24rpx 28rpx;
}

.log-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.log-header {
  margin-bottom: 16rpx;
}

.action-badge {
  padding: 6rpx 20rpx;
  border-radius: 999px;
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
}

.action-badge.create {
  background: #52c41a;
}

.action-badge.update {
  background: #1890ff;
}

.action-badge.delete {
  background: #ff4d4f;
}

.action-badge.login {
  background: #722ed1;
}

.action-badge.logout {
  background: #8c8c8c;
}

.action-badge.approve {
  background: #13c2c2;
}

.action-badge.reject {
  background: #fa8c16;
}

.action-badge.review {
  background: #eb2f96;
}

.action-badge.default {
  background: #666;
}

.log-time {
  font-size: 24rpx;
  color: #999;
}

.log-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.log-row {
  display: flex;
  font-size: 26rpx;
  line-height: 1.5;
}

.log-label {
  color: #666;
  min-width: 150rpx;
}

.log-value {
  color: #333;
  flex: 1;
}



.empty {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.loading-more,
.no-more {
  padding: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
