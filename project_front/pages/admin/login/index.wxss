@import '../../../styles/common.wxss';

page {
  height: 100vh;
  background: #010409;
}

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(0,8,18,0.35), rgba(1,3,5,0.75));
}

.hero {
  position: absolute;
  top: 6vh;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 2;
  padding: 0 40rpx;
}

.hero-line {
  display: block;
  color: #fff;
  font-size: 60rpx;
  font-family: 'STXinwei','KaiTi','STKaiti','Noto Serif SC',serif;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.6), 0 -2rpx 0 rgba(255,255,255,0.25);
  line-height: 1.8;
}

.role-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  padding: 6rpx 36rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #e04b4b, #f06c6c);
  color: #fff;
  font-size: 28rpx;
  font-family: 'KaiTi','STKaiti','Kaiti SC','Noto Serif SC',serif;
  box-shadow: 0 4rpx 12rpx rgba(224,75,75,0.45);
}

.hero-tip {
  display: block;
  margin-top: 12rpx;
  color: rgba(255,230,230,0.9);
  font-size: 26rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.45);
}

.login-card {
  position: absolute;
  left: 50%;
  bottom: 9vh;
  width: 82vw;
  transform: translateX(-50%);
  padding: 48rpx 44rpx;
  background: rgba(0,15,30,0.72);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.45);
  backdrop-filter: blur(10rpx);
  z-index: 3;
}

.card-head {
  margin-bottom: 32rpx;
}

.card-title {
  display: block;
  color: #ffe7e7;
  font-size: 44rpx;
  font-family: 'KaiTi','STKaiti','Kaiti SC','Noto Serif SC',serif;
  text-shadow: 0 3rpx 6rpx rgba(0,0,0,0.5);
}

.card-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(255,225,225,0.8);
  font-size: 26rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.95);
  border-radius: 16rpx;
  padding: 0 28rpx;
  height: 100rpx;
  margin-bottom: 26rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.15);
}

.input-icon {
  font-size: 38rpx;
  margin-right: 18rpx;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #1f1f1f;
}

.input-placeholder {
  color: #a0a0a0;
}

.eye-icon {
  font-size: 26rpx;
  color: #e04b4b;
  padding: 8rpx 12rpx;
  background: rgba(224,75,75,0.1);
  border-radius: 8rpx;
}

.helper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
  font-size: 26rpx;
}

.checkbox-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: transparent;
}

.checkbox.checked {
  background: linear-gradient(135deg, #e04b4b, #f06c6c);
  border-color: transparent;
}

.checkbox-label {
  color: rgba(255,255,255,0.85);
}

.link-text {
  color: #ffb8b8;
}

.primary-btn {
  width: 100%;
  height: 100rpx;
  border: none;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #e04b4b, #f06c6c);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(224,75,75,0.5);
}

.primary-btn.disabled {
  opacity: 0.6;
}

.divider {
  height: 1rpx;
  background: rgba(255,255,255,0.2);
  margin: 34rpx 0;
}

.security-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 24rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 18rpx;
  font-size: 26rpx;
  color: rgba(255,220,220,0.85);
  gap: 12rpx;
}

.tip-icon {
  font-size: 32rpx;
}

.corner-dots {
  position: absolute;
  bottom: 36rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 16rpx;
  z-index: 2;
}

.corner-dots .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.4);
}
