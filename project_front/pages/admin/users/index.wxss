@import '/styles/common.wxss';

.users-page {
  min-height: 100vh;
  background: #f7f7f5;
  padding-bottom: 48rpx;
}

.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  flex: 1;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.search-input {
  flex: 1;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.search-btn {
  padding: 16rpx 32rpx;
  background: #e04b4b;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.stats-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.stats-text {
  font-size: 26rpx;
  color: #666;
}

.refresh-btn {
  background: #e04b4b;
  color: #fff;
  border-radius: 999px;
  font-size: 24rpx;
}

.user-list {
  height: calc(100vh - 360rpx);
  padding: 24rpx 28rpx;
}

.user-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.user-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.user-username {
  font-size: 26rpx;
  color: #888;
}

.user-status {
  padding: 8rpx 24rpx;
  border-radius: 999px;
  font-size: 24rpx;
  font-weight: 500;
}

.user-status.active {
  background: #e7f7ed;
  color: #52c41a;
}

.user-status.inactive {
  background: #fff1f0;
  color: #ff4d4f;
}

.user-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.user-roles {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.role-tag {
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #e04b4b, #f06c6c);
  color: #fff;
  border-radius: 999px;
  font-size: 24rpx;
}

.user-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  background: #e04b4b;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.empty {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.loading-more,
.no-more {
  padding: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal.show {
  display: flex;
}

.modal-content {
  width: 85vw;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.modal-desc {
  display: block;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #666;
}

.role-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  transition: all 0.2s;
}

.role-option.selected {
  background: #ffe7e7;
  border: 2rpx solid #e04b4b;
}

.checkbox {
  font-size: 32rpx;
  color: #e04b4b;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #e04b4b;
  color: #fff;
}
