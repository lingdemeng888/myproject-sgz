<view class="container">
  <image class="bg" src="../assets/乐技楼.jpg" mode="aspectFill"></image>
  <view class="overlay"></view>

  <view class="header">
    <text class="title-line">苏州高等职业技术学校</text>
    <text class="title-line">毕业设计选题管理系统</text>
  </view>

  <view class="options">
    <view class="option" bindtap="goStudent">
      <text class="option-text">我是学生</text>
      <text class="option-desc">浏览选题 · 申请选题 · 提交论文</text>
    </view>
    <view class="option" bindtap="goTutor">
      <text class="option-text">我是导师</text>
      <text class="option-desc">发布选题 · 审批申请 · 指导学生</text>
    </view>
    <view class="option" bindtap="goAdmin">
      <text class="option-text">我是管理员</text>
      <text class="option-desc">用户管理 · 系统配置 · 数据维护</text>
    </view>
  </view>
</view>
