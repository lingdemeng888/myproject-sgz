@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  background: #f7f7f5;
  padding: 60rpx 28rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.08);
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  margin: 0 auto 24rpx;
  background: #b58863;
  color: #fff;
  font-size: 72rpx;
  font-weight: 600;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(181, 136, 99, 0.3);
}

.name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.role {
  font-size: 26rpx;
  color: #999;
}

.info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 999px;
  box-shadow: 0 8rpx 20rpx rgba(255, 77, 79, 0.25);
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 100rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

