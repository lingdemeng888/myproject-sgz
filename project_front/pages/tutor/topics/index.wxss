.topics-page {
  min-height: 100vh;
  background: #f7f7f5;
  padding-bottom: 20rpx;
}

/* 顶部操作栏 */
.top-bar {
  background: #fff;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f7f7f5;
  border-radius: 999px;
  padding: 0 24rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
}

.search-btn {
  background: #b58863;
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 26rpx;
}

.add-btn {
  background: #b58863;
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 20rpx 0;
  margin-top: 2rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  background: #f7f7f5;
  border-radius: 999px;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.filter-item.active {
  background: #b58863;
  color: #fff;
}

/* 选题列表 */
.topic-list {
  height: calc(100vh - 260rpx);
  padding: 20rpx 24rpx;
}

.topic-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.06);
  transition: all 0.3s;
}

.topic-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.topic-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.topic-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
}

.status-badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999px;
  font-size: 24rpx;
  color: #fff;
}

.topic-meta {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #999;
}

.topic-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.topic-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.topic-time {
  font-size: 24rpx;
  color: #999;
}

.topic-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999px;
  font-size: 24rpx;
  border: none;
}

.action-btn.edit {
  background: #f0f0f0;
  color: #666;
}

.action-btn.publish {
  background: #b58863;
  color: #fff;
}

.action-btn.lock {
  background: #fa8c16;
  color: #fff;
}

.action-btn.archive {
  background: #d9d9d9;
  color: #666;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #b58863;
  color: #fff;
  border: none;
  border-radius: 999px;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

/* 加载状态 */
.loading,
.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}
