@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  background: #f7f7f5;
  padding: 28rpx;
  padding-bottom: 40rpx;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.input {
  flex: 1;
  min-width: 200rpx;
  background: #fff;
  border-radius: 999px;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
}

.filter-btn {
  background: #b58863;
  color: #fff;
  font-size: 24rpx;
  border-radius: 999px;
  box-shadow: 0 4rpx 12rpx rgba(181, 136, 99, 0.2);
}

.list {
  margin-top: 8rpx;
}

.card {
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s;
}

.card:active {
  transform: scale(0.98);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.status-pill {
  padding: 6rpx 18rpx;
  border-radius: 999px;
  font-size: 24rpx;
  color: #fff;
  white-space: nowrap;
  font-weight: 600;
}

.info-row {
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.info-row:last-of-type {
  margin-bottom: 0;
}

.label {
  color: #999;
}

.value {
  color: #333;
}

.card-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid #f5f5f5;
  text-align: center;
}

.tip {
  color: #ff4d4f;
  font-size: 24rpx;
  font-weight: 600;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 100rpx 0;
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.load-more {
  text-align: center;
  padding: 20rpx 0;
}

.load-more button {
  background: #fff;
  color: #b58863;
  font-size: 24rpx;
  border-radius: 999px;
  border: 1px solid #b58863;
}

