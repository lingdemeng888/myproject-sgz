@import '/styles/common.wxss';

.home {
  min-height: 100vh;
  background: #f7f7f5;
  padding: 32rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.08);
}

.hero-text {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hello {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
}

.meta {
  font-size: 26rpx;
  color: #666;
}

.actions .mini-btn {
  background: #b58863;
  color: #fff;
  border-radius: 999px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stat-number {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #b58863;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
  margin-bottom: 32rpx;
}

.quick-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 12rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: transform 0.2s;
}

.quick-card:active {
  transform: scale(0.95);
}

.quick-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #b58863;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.quick-card text:last-child {
  font-size: 26rpx;
  color: #444;
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-link {
  font-size: 26rpx;
  color: #b58863;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.card:last-child {
  margin-bottom: 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
}

.card-meta {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.status-pill {
  display: inline-flex;
  padding: 6rpx 18rpx;
  border-radius: 999px;
  font-size: 24rpx;
  color: #fff;
  margin-bottom: 6rpx;
}

.empty {
  padding: 60rpx 32rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

