<view class="page">
  <image class="bg" src="../assets/乐技楼.jpg" mode="aspectFill" />
  <view class="overlay"></view>

  <view class="hero">
    <text class="hero-line">苏州高等职业技术学校</text>
    <text class="hero-line">毕业设计选题管理系统</text>
    <view class="role-chip">
      <text>导师注册</text>
    </view>
    <text class="hero-tip">实名备案 · 指导角色 · 安全开通</text>
  </view>

  <scroll-view class="form-scroll" scroll-y>
    <view class="form-card">
      <view class="card-head">
        <text class="card-title">开通导师账号</text>
        <text class="card-desc">请填写工号、教学部门及联系方式</text>
      </view>

      <view class="input-group">
        <text class="input-icon">🧑‍🏫</text>
        <input class="input-field" placeholder="工号（同时作为登录用户名）" value="{{no}}" data-field="no" bindinput="onFieldInput" />
      </view>

      <view class="input-group">
        <text class="input-icon">👤</text>
        <input class="input-field" placeholder="姓名" value="{{name}}" data-field="name" bindinput="onFieldInput" />
      </view>

      <view class="input-group picker-group">
        <text class="input-icon">🏢</text>
        <picker
          class="picker-field"
          mode="selector"
          range="{{deptOptions}}"
          range-key="name"
          value="{{deptIndex}}"
          bindchange="onDeptChange"
          disabled="{{deptLoading || !deptOptions.length}}"
        >
          <view class="picker-text">{{deptName || '请选择所属院系'}}</view>
        </picker>
      </view>
      <text class="helper-hint" wx:if="{{deptLoading}}">正在加载院系列表…</text>
      <text class="helper-hint" wx:else>院系数据来自后台已启用专业</text>

      <view class="input-group">
        <text class="input-icon">📱</text>
        <input class="input-field" type="number" maxlength="11" placeholder="联系电话" value="{{phone}}" data-field="phone" bindinput="onFieldInput" />
      </view>
      <text class="helper-hint">手机号用于系统通知及密码找回</text>

      <view class="input-group">
        <text class="input-icon">✉️</text>
        <input class="input-field" type="text" placeholder="电子邮箱（可选）" value="{{email}}" data-field="email" bindinput="onFieldInput" />
      </view>
      <text class="helper-hint">请填写常用邮箱以便接收系统通知</text>

      <view class="input-group">
        <text class="input-icon">🔐</text>
        <input class="input-field" password placeholder="设置登录密码（至少6位）" value="{{pwd1}}" data-field="pwd1" bindinput="onFieldInput" />
      </view>

      <view class="input-group">
        <text class="input-icon">✅</text>
        <input class="input-field" password placeholder="再次输入密码" value="{{pwd2}}" data-field="pwd2" bindinput="onFieldInput" />
      </view>

      <button class="primary-btn" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交注册'}}
      </button>

      <view class="link-row">
        <text class="hint-text">已有账号？</text>
        <text class="link-text" bindtap="backToLogin">返回登录</text>
      </view>
    </view>
  </scroll-view>

  <view class="corner-dots">
    <view class="dot"></view>
    <view class="dot"></view>
    <view class="dot"></view>
  </view>
</view>
