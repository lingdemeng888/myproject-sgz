@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  background: #f7f7f5;
  padding: 28rpx;
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.tab {
  flex: 1 0 auto;
  padding: 16rpx 20rpx;
  text-align: center;
  border-radius: 999px;
  background: #fff;
  color: #666;
  font-size: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.tab.active {
  background: #b58863;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(181, 136, 99, 0.3);
}

.filters {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.input {
  flex: 1;
  background: #fff;
  border-radius: 999px;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
}

.filter-btn {
  background: #b58863;
  color: #fff;
  font-size: 24rpx;
  border-radius: 999px;
  box-shadow: 0 4rpx 12rpx rgba(181, 136, 99, 0.2);
}

.list {
  margin-top: 8rpx;
}

.card {
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.status-pill {
  padding: 6rpx 18rpx;
  border-radius: 999px;
  font-size: 24rpx;
  color: #fff;
  white-space: nowrap;
  font-weight: 600;
}

.info-row {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.info-row:last-of-type {
  margin-bottom: 0;
}

.label {
  color: #999;
}

.value {
  color: #333;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px solid #f0f0f0;
}

.action-btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 999px;
  height: 64rpx;
  line-height: 64rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.action-btn.approve {
  background: #52c41a;
  color: #fff;
}

.action-btn.reject {
  background: #ff4d4f;
  color: #fff;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 100rpx 0;
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.load-more {
  text-align: center;
  padding: 20rpx 0;
}

.load-more button {
  background: #fff;
  color: #b58863;
  font-size: 24rpx;
  border-radius: 999px;
  border: 1px solid #b58863;
}

