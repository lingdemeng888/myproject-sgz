@import '../../../styles/common.wxss';

page {
  height: 100vh;
  background: #050505;
}

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(150deg, rgba(6,1,0,0.3), rgba(14,14,14,0.7));
}

.hero {
  position: absolute;
  top: 6vh;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 2;
  padding: 0 40rpx;
}

.hero-line {
  display: block;
  color: #fff;
  font-size: 60rpx;
  font-family: 'STXinwei','华文新魏','KaiTi','STKaiti','Noto Serif SC',serif;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.6), 0 -2rpx 0 rgba(255,255,255,0.25);
  line-height: 1.8;
}

.role-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  padding: 6rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(214,138,92,0.9);
  color: #fff;
  font-size: 28rpx;
  font-family: 'KaiTi','STKaiti','Kaiti SC','Noto Serif SC',serif;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.35);
}

.hero-tip {
  display: block;
  margin-top: 12rpx;
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.45);
}

.login-card {
  position: absolute;
  left: 50%;
  bottom: 9vh;
  width: 82vw;
  transform: translateX(-50%);
  padding: 48rpx 44rpx;
  background: rgba(6, 6, 6, 0.62);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.35);
  backdrop-filter: blur(8rpx);
  z-index: 3;
}

.card-head {
  margin-bottom: 32rpx;
}

.card-title {
  display: block;
  color: #fff;
  font-size: 44rpx;
  font-family: 'KaiTi','STKaiti','Kaiti SC','Noto Serif SC',serif;
  text-shadow: 0 3rpx 6rpx rgba(0,0,0,0.5);
}

.card-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(255,255,255,0.8);
  font-size: 26rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.93);
  border-radius: 16rpx;
  padding: 0 28rpx;
  height: 100rpx;
  margin-bottom: 26rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.2);
}

.input-icon {
  font-size: 38rpx;
  margin-right: 18rpx;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: #1f1f1f;
}

.input-placeholder {
  color: #a0a0a0;
}

.eye-icon {
  font-size: 38rpx;
  color: #666;
}

.helper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
  font-size: 26rpx;
}

.checkbox-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: transparent;
}

.checkbox.checked {
  background: rgba(214,138,92,0.95);
  border-color: transparent;
}

.checkbox-label {
  color: rgba(255,255,255,0.85);
}

.link-text {
  color: #ffe7c2;
}

.primary-btn {
  width: 100%;
  height: 100rpx;
  border: none;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #c56241, #f08b4b);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 26rpx rgba(0,0,0,0.35);
}

.primary-btn.disabled {
  opacity: 0.6;
}

.divider {
  height: 1rpx;
  background: rgba(255,255,255,0.15);
  margin: 34rpx 0;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 26rpx;
}

.hint-text {
  color: rgba(255,255,255,0.8);
}

.corner-dots {
  position: absolute;
  bottom: 36rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 16rpx;
  z-index: 2;
}

.corner-dots .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.4);
}
